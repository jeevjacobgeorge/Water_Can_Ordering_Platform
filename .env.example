# Local Docker Compose configuration
POSTGRES_USER=watercan
POSTGRES_PASSWORD=watercan_dev
POSTGRES_DB=watercan
DATABASE_URL=postgresql+asyncpg://watercan:watercan_dev@db:5432/watercan

JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRE_MINUTES=480
SEED_OWNER_PASSWORD=replace-owner-development-password
SEED_STAFF_PASSWORD=replace-staff-development-password

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
DEBUG=true
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
